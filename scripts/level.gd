extends Node3D
## Shared hero stage reused by every generated room scene.
## It owns the hero and the camera; each room scene only brings its own map.
## The hero spawns near the map center, or at the arrival point of a warp
## executed from the previous room. Warp zones (from the room metadata
## generated by mapdata/convert_tmx_to_tscn.py) teleport the hero between
## rooms; falling below the map uses the room's fall destination.

# State shared between room scenes so a warp can schedule its spawn point
# before `change_scene_to_file()` swaps the scene.
static var _pending_arrival: Dictionary = {}

const WARP_TILE_BASE := 12      # warp raw coords -> heightmap cell offset
const FALL_TRIGGER_HEIGHT := -5.0
const SPAWN_Y_OFFSET := 0.51
const WARP_ZONE_COLOR := Color(1.0, 0.15, 0.15, 0.45)
const WARP_ARRIVAL_COLOR := Color(0.15, 1.0, 0.3, 0.45)
const MAP_EDGE_EPS := 0.02
const _SPAWN_NEIGHBORS: Array[Vector2i] = [
	Vector2i(-1, 0), Vector2i(1, 0), Vector2i(0, -1), Vector2i(0, 1),
	Vector2i(-1, -1), Vector2i(1, -1), Vector2i(-1, 1), Vector2i(1, 1),
]

@onready var _hero: CharacterBody3D = $Player

var _grid_map: GridMap
var _column_tops: Dictionary = {}   # column (Vector2i) -> highest layer
var _map_bounds := Rect2i()         # walkable cell rectangle. size zero = unknown
var _room_number := -1
var _warps: Array = []
var _fall_destination := -1
var _prev_hero_tile := Vector2i(-32768, -32768)
var _transitioning := false


func _ready() -> void:
	_read_room_metadata()
	_place_hero_on_map.call_deferred()


func _physics_process(_delta: float) -> void:
	if _transitioning or _grid_map == null or _hero == null or not is_inside_tree():
		return
	var tile := _hero_tile()
	# Warp zones only trigger when the hero enters a new tile: standing on
	# the arrival tile of the reverse warp does not fire it again.
	if tile != _prev_hero_tile:
		_prev_hero_tile = tile
		_check_warps(tile)
	if _fall_destination >= 0:
		_check_fall()
	_clamp_hero_to_map()


func _read_room_metadata() -> void:
	var room: Node = get_parent()
	if not room.has_meta("room_number"):
		return
	_room_number = int(room.get_meta("room_number"))
	_fall_destination = int(room.get_meta("warp_fall_dest", -1))
	_warps = room.get_meta("warps", [])


func _place_hero_on_map() -> void:
	_grid_map = _find_grid_map()
	_collect_column_tops()
	if _grid_map == null or _column_tops.is_empty():
		return
	var column := _spawn_column()
	if not _column_tops.has(column):
		column = _nearest_walkable_column(column)
	# Spawn above the tallest block of the neighborhood so the capsule never
	# overlaps a wall and gets pushed into an adjacent tile by physics recovery.
	var top: int = _column_tops[column]
	for offset: Vector2i in _SPAWN_NEIGHBORS:
		var neighbor := column + offset
		if _column_tops.has(neighbor):
			top = maxi(top, int(_column_tops[neighbor]))
	_hero.global_position = grid_map_position(column) \
		+ Vector3(0.0, float(top) + 1.0 + SPAWN_Y_OFFSET, 0.0)
	_prev_hero_tile = Vector2i(int(_hero.global_position.x), int(_hero.global_position.z))
	_debug_show_warps()
	_display_entities.call_deferred()


## Entities: one static billboard each, feet on the tile top surface.
## TMX positions are cursor coordinates; our 3D world is the same space
## shifted by WARP_TILE_BASE. The TMX Z is the heightmap height level,
## i.e. the same value as the top grid cell of the column.
func _display_entities() -> void:
	var entities: Array = get_parent().get_meta("entities", [])
	var index := 0
	for meta: Dictionary in entities:
		var sprite := EntityBillboard.create(meta)
		if sprite == null:
			continue
		var ground_z := float(meta.get("z", 0.0))
		sprite.position = Vector3(
			float(meta.get("x", 0.0)) - WARP_TILE_BASE,
			1.0 + ground_z,
			float(meta.get("y", 0.0)) - WARP_TILE_BASE)
		sprite.name += "_%d" % index
		index += 1
		add_child(sprite)


## Zone rect (heightmap-local cells), arrival cell and destination room of a
## warp, seen from this room either when it is room1 or via room2.
func _warp_coordinates(warp: Dictionary) -> Dictionary:
	var from_room1 := _room_number == int(warp.get("room1", -1))
	var origin_raw: Vector2i
	var arrival_raw: Vector2i
	if from_room1:
		origin_raw = Vector2i(int(warp.get("x", 0)), int(warp.get("y", 0)))
		arrival_raw = Vector2i(int(warp.get("x2", 0)), int(warp.get("y2", 0)))
	else:
		origin_raw = Vector2i(int(warp.get("x2", 0)), int(warp.get("y2", 0)))
		arrival_raw = Vector2i(int(warp.get("x", 0)), int(warp.get("y", 0)))
	var destination: int
	if from_room1:
		destination = int(warp.get("room2", -1))
	else:
		destination = int(warp.get("room1", -1))
	return {
		"origin": origin_raw - Vector2i(WARP_TILE_BASE, WARP_TILE_BASE),
		"size": Vector2i(int(warp.get("width", 1)), int(warp.get("height", 1))),
		"arrival": arrival_raw - Vector2i(WARP_TILE_BASE, WARP_TILE_BASE),
		"destination": destination,
	}


## World position of a cell in our 3D grid (cell centers at half-unit steps).
func grid_map_position(column: Vector2i) -> Vector3:
	return _grid_map.map_to_local(Vector3i(column.x, 0, column.y))


func _spawn_column() -> Vector2i:
	if _room_number >= 0 \
			and not _pending_arrival.is_empty() \
			and int(_pending_arrival.get("room", -1)) == _room_number:
		var column := Vector2i(int(_pending_arrival["x"]), int(_pending_arrival["y"]))
		_pending_arrival.clear()
		return column
	return _nearest_walkable_column(_columns_center())


func _nearest_walkable_column(target: Vector2i) -> Vector2i:
	var nearest: Vector2i = _column_tops.keys()[0]
	var nearest_distance := INF
	for column: Vector2i in _column_tops:
		var distance := absi(column.x - target.x) + absi(column.y - target.y)
		if distance < nearest_distance:
			nearest = column
			nearest_distance = distance
	return nearest


func _hero_tile() -> Vector2i:
	return Vector2i(floori(_hero.global_position.x), floori(_hero.global_position.z))


func _check_warps(tile: Vector2i) -> void:
	for warp: Dictionary in _warps:
		var zone := _warp_coordinates(warp)
		var origin: Vector2i = zone["origin"]
		var arrival: Vector2i = zone["arrival"]
		var size: Vector2i = zone["size"]
		if tile.x < origin.x or tile.y < origin.y:
			continue
		if tile.x >= origin.x + size.x or tile.y >= origin.y + size.y:
			continue
		_pending_arrival = {
			"room": zone["destination"],
			"x": arrival.x,
			"y": arrival.y,
		}
		_change_room(zone["destination"])
		return


func _check_fall() -> void:
	if not _hero.is_inside_tree():
		return
	if _hero.global_position.y <= FALL_TRIGGER_HEIGHT:
		# Falls land below the same local coordinates in the target room.
		_pending_arrival = {
			"room": _fall_destination,
			"x": _prev_hero_tile.x,
			"y": _prev_hero_tile.y,
		}
		_change_room(_fall_destination)


func _change_room(room: int) -> void:
	if room < 0:
		_pending_arrival.clear()
		return
	_transitioning = true
	if not is_inside_tree():
		# Scene already torn down; the warp cannot execute anymore.
		_pending_arrival.clear()
		_transitioning = false
		return
	get_tree().change_scene_to_file("res://scenes/rooms/Room%03d.tscn" % room)


func _find_grid_map() -> GridMap:
	# The GridMap belongs to the room scene, next to the instanced level.
	var parent := get_parent()
	for child in parent.get_children():
		if child is GridMap:
			return child
	push_warning("No GridMap found beside the level, hero stays where it is.")
	return null


## Debug overlay: one translucent red cube hovering over each warp-zone cell
## of this room, and a green cube over each arrival cell.
func _debug_show_warps() -> void:
	var pad := BoxMesh.new()
	pad.size = Vector3(0.9, 0.2, 0.9)
	for warp: Dictionary in _warps:
		var zone := _warp_coordinates(warp)
		var origin: Vector2i = zone["origin"]
		var size: Vector2i = zone["size"]
		for dx in size.x:
			for dy in size.y:
				_show_warp_pad(pad, Vector2i(origin.x + dx, origin.y + dy), WARP_ZONE_COLOR)
		_show_warp_pad(pad, zone["arrival"], WARP_ARRIVAL_COLOR)


func _show_warp_pad(pad: BoxMesh, cell: Vector2i, color: Color) -> void:
	if not _column_tops.has(cell):
		return
	var pad_mesh := MeshInstance3D.new()
	pad_mesh.mesh = pad
	var material := StandardMaterial3D.new()
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	material.albedo_color = color
	# Unshaded so pads stay visible in shadowed patches, too.
	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	pad_mesh.material_override = material
	pad_mesh.position = grid_map_position(cell) \
		+ Vector3(0.0, float(_column_tops[cell]) + 1.1, 0.0)
	add_child(pad_mesh)


func _collect_column_tops() -> void:
	_column_tops.clear()
	if _grid_map == null:
		return
	var initialized := false
	for cell in _grid_map.get_used_cells():
		var key := Vector2i(cell.x, cell.z)
		if not _column_tops.has(key) or cell.y > _column_tops[key]:
			_column_tops[key] = cell.y
		if initialized:
			var lo := Vector2i(mini(_map_bounds.position.x, key.x),
				mini(_map_bounds.position.y, key.y))
			var hi := Vector2i(maxi(_map_bounds.end.x - 1, key.x),
				maxi(_map_bounds.end.y - 1, key.y))
			_map_bounds = Rect2i(lo.x, lo.y, hi.x - lo.x + 1, hi.y - lo.y + 1)
		else:
			_map_bounds = Rect2i(key.x, key.y, 1, 1)
			initialized = true


## The hero never walks off the map: positions are clamped to the cell
## rectangle covered by the GridMap. Pits inside the map remain open, only
## the border is sealed.
func _clamp_hero_to_map() -> void:
	if _map_bounds.size == Vector2i.ZERO:
		return
	var pos: Vector3 = _hero.global_position
	var clamped := false
	if pos.x < _map_bounds.position.x + MAP_EDGE_EPS:
		pos.x = _map_bounds.position.x + MAP_EDGE_EPS
		clamped = true
	elif pos.x >= _map_bounds.end.x:
		pos.x = _map_bounds.end.x - MAP_EDGE_EPS
		clamped = true
	if pos.z < _map_bounds.position.y + MAP_EDGE_EPS:
		pos.z = _map_bounds.position.y + MAP_EDGE_EPS
		clamped = true
	elif pos.z >= _map_bounds.end.y:
		pos.z = _map_bounds.end.y - MAP_EDGE_EPS
		clamped = true
	if clamped:
		_hero.global_position = pos


func _columns_center() -> Vector2i:
	var min_x := INF
	var max_x := -INF
	var min_y := INF
	var max_y := -INF
	for column: Vector2i in _column_tops:
		min_x = mini(min_x, column.x)
		max_x = maxi(max_x, column.x)
		min_y = mini(min_y, column.y)
		max_y = maxi(max_y, column.y)
	return Vector2i(int((min_x + max_x) / 2.0), int((min_y + max_y) / 2.0))
